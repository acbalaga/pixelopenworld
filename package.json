{
  "name": "pixelopenworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "bench": "vitest run --config vitest.bench.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dev",
    "bake": "tsx tools/bake-assets/index.ts",
    "bake:check": "tsx tools/bake-assets/index.ts --check",
    "e2e": "npm run build && playwright test",
    "validate": "tsx tools/bake-assets/index.ts --validate",
    "check:dev": "tsx tools/check-dev-absent.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0",
    "zod": "^4.6.7"
  }
}
